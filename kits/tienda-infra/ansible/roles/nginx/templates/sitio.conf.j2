# {{ ansible_managed }}
server {
    listen 80;
    server_name {{ nginx_dominio }};
    server_tokens off;
    root {{ nginx_raiz }};

    location / {
        try_files $uri $uri/ =404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:{{ nginx_puerto_app }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
{% if nginx_entorno == "prod" %}

    access_log /var/log/nginx/sitio.log;
{% endif %}
}
